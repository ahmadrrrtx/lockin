    <string name="protection_release_admin">Deactivate device admin</string>
    <string name="protection_admin_active_notice">Device admin is active.</string>
    <string name="protection_admin_lost">Device admin protection was turned off.</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Lock in your focus</string>
    <string name="onboarding_page1_title">Choose your focus. Commit to it.</string>
    <string name="onboarding_page1_body">Lockin blocks the apps you pick for the duration you choose. Once a session starts, there is no cancel button — the whole point is that you cannot casually change your mind.</string>
    <string name="onboarding_page2_title">How it works</string>
    <string name="onboarding_page2_body">1. Select the apps you want locked.\n2. Pick a duration and confirm your commitment.\n3. When you press START, those apps stay locked until the timer ends — across restarts and reboots.</string>
    <string name="onboarding_page3_title">Two permissions, clearly explained</string>
    <string name="onboarding_page3_body">• Accessibility service — detects when a locked app comes to the foreground so Lockin can show the block screen. It never reads screen content.\n• Notifications — shows the session countdown and warns you if protection is turned off.\n\nEverything stays on this device. Lockin has no Internet permission.</string>
    <string name="onboarding_enable_accessibility">Enable blocker service</string>
