    <string name="accessibility_service_label">Lockin Focus Blocker</string>
    <string name="accessibility_service_description">Lockin uses this service to detect when a locked app is opened during an active focus session and immediately returns you to Lockin\'s block screen. It only observes which window is in the foreground — it never reads, stores, or inspects the content of your screens.</string>
    <string name="device_admin_description">Allows Lockin to add friction when the app is uninstalled while a focus commitment is active.</string>

