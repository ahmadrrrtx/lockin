    <!-- Protection center -->
    <string name="protection_title">Protection center</string>
    <string name="protection_intro">Lockin shows exactly what is enforced right now and what Android still allows. Nothing here is exaggerated.</string>
    <string name="protection_state_on">Enforced</string>
    <string name="protection_state_off">Off</string>
    <string name="protection_state_degraded">Degraded</string>
    <string name="protection_state_unavailable">Not available</string>
    <string name="protection_blocker_row">Focus blocker service</string>
    <string name="protection_blocker_desc">Detects locked apps in the foreground and shows the block screen.</string>
    <string name="protection_admin_row">Device admin</string>
    <string name="protection_admin_desc">Must be deactivated before Lockin can be uninstalled on most devices.</string>
    <string name="protection_owner_row">Enhanced uninstall blocking</string>
    <string name="protection_owner_desc">Available only if this device was provisioned with Lockin as a device owner. Standard personal phones cannot grant this without enterprise provisioning or factory-level setup, so Lockin does not pretend otherwise.</string>
    <string name="protection_battery_row">Battery exemption</string>
    <string name="protection_battery_desc">Exact completion alarms fire more reliably when Lockin is exempt from battery optimization.</string>
    <string name="protection_alarm_row">Exact alarm permission</string>
    <string name="protection_alarm_desc">Lets the completion alarm fire at the precise end time.</string>
    <string name="protection_time_row">Time integrity</string>
    <string name="protection_time_desc">Monotonic clock is used while the phone stays on; the persisted wall clock covers reboots. Backward clock changes are detected and reported.</string>
    <string name="protection_honest_title">What Android still allows</string>
    <string name="protection_honest_body">On a standard personal phone, no app can guarantee it can never be removed. A determined user can still turn off the accessibility service in Android settings, force-stop Lockin, or uninstall it after removing admin rights. Lockin makes casual escape hard and deliberate, and reports honestly when a protection is lost.</string>
